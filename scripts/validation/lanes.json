{
  "build": "vite build",
  "check": "pnpm check:storybook-parity && pnpm spec:validate && pnpm check:types && pnpm check:rust && pnpm check:rust:e2e && pnpm format:check",
  "check:types": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
  "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
  "check:architecture": "node scripts/source-audit.mjs",
  "check:app-ownership": "node scripts/source-audit.mjs --app-only",
  "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
  "test": "node --import tsx --test tests/governance/*.test.mjs tests/renderer/*.test.mjs && pnpm test:ai && cargo test --manifest-path src-tauri/Cargo.toml --locked",
  "test:ai": "vitest run --config vitest.ai.config.mjs",
  "test:desktop": "node scripts/desktop-tests.mjs",
  "test:desktop:headless": "node scripts/desktop-tests.mjs --headless",
  "spec:validate": "spec-validator validate",
  "spec:first": "spec-validator first",
  "spec:check": "spec-validator check",
  "spec:build": "spec-validator build",
  "build-storybook": "storybook build --disable-telemetry",
  "test:storybook": "node scripts/catalog-tests.mjs",
  "check:all": "pnpm check && pnpm test && pnpm build",
  "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
  "validation:check": "node --test tests/governance/validation.test.mjs tests/governance/validation-native.test.mjs tests/governance/validation-leases.test.mjs tests/governance/validation-dispatch.test.mjs tests/governance/storybook-parity.test.mjs tests/governance/catalog-reports.test.mjs tests/governance/storybook-runtime-warnings.test.mjs",
  "validation:smoke": "node scripts/validation/smoke.mjs",
  "check:storybook-parity": "node scripts/spec-validation/check-storybook-parity.mjs",
  "check:rust:e2e": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --features e2e --locked -- -D warnings",
  "check:evidence": "node scripts/evidence.mjs"
}
