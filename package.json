    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "axe-core": "^4.13.0",
    "prettier": "3.3.3",
    "prettier-plugin-svelte": "^3.5.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "semver": "^7.8.5",
    "storybook": "10.6.5",
    "svelte-check": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "webdriverio": "9.32.0",
