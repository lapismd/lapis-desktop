{
  "name": "@lapismd/lapis-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24.10 || >=26"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build",
    "check": "pnpm spec:validate && pnpm check:types && pnpm check:rust && pnpm format:check",
    "check:types": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "check:architecture": "node scripts/source-audit.mjs",
    "check:app-ownership": "node scripts/source-audit.mjs --app-only",
    "check:progress": "node scripts/progress.mjs",
    "progress:generate": "node scripts/progress.mjs --write",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test": "node --test tests/governance/*.test.mjs tests/renderer/*.test.mjs && pnpm test:ai && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:desktop": "node scripts/desktop-tests.mjs",
    "desktop:bundle": "tauri build --bundles app",
    "spec:validate": "spec-validator validate",
    "spec:first": "spec-validator first",
    "spec:check": "spec-validator check",
    "spec:build": "spec-validator build",
    "spec:serve": "spec-validator serve",
    "spec:search": "spec-validator search",
    "check:bundle": "node scripts/check-bundle.mjs",
    "local:install": "node scripts/local-archives.mjs",
    "local:pack": "node scripts/pack-local-core.mjs",
    "storybook": "storybook dev --host 127.0.0.1 --port 7480 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:storybook": "node scripts/catalog-tests.mjs",
    "test:ai": "vitest run --config vitest.ai.config.mjs",
    "test:desktop:headless": "node scripts/desktop-tests.mjs --headless",
    "test:desktop:headed": "node scripts/desktop-tests.mjs --headed",
    "test:desktop:api": "node scripts/desktop-api-tests.mjs"
  },
  "dependencies": {
    "@lapis-notes/api": "^0.1.4",
    "@lapis-notes/file-explorer": "^0.1.2",
    "@lapis-notes/graph": "^0.1.3",
    "@lapis-notes/language-service": "^0.1.1",
    "@lapis-notes/markdown": "^0.1.6",
    "@lapis-notes/search": "^0.1.3",
    "@lapis-notes/source-editor": "^0.1.2",
    "@lapis-notes/ui": "^0.1.3",
    "@lapis-notes/workspace": "^0.2.1",
    "@lapismd/design-core": "^0.4.0 || ^0.5.1",
    "@lapismd/mira": "~0.0.5",
    "@lapismd/mira-editor": "~0.0.2",
    "@lapismd/mira-plugin-ai": "~0.0.2",
    "@lapismd/mira-plugin-mermaid": "~0.0.2",
    "@tauri-apps/api": "~2.12.4",
    "svelte": "5.57.2",
    "@lapismd/terminal": "link:../lapis-terminal/packages/terminal",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11",
    "yaml": "^2.9.1",
    "@lapismd/agent-redaction": "^0.1.0",
    "@cfworker/json-schema": "^4.1.1",
    "@lucide/svelte": "^1.57.0",
    "@lapismd/ai": "link:../lapis-ai/packages/ai"
  },
  "devDependencies": {
    "@lapismd/spec-validator": "^0.1.4",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/svelte-vite": "10.5.7",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.10.0",
    "@vitest/browser-playwright": "4.1.11",
    "@wdio/cli": "9.31.2",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.2",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "axe-core": "^4.13.0",
    "prettier": "3.3.3",
    "prettier-plugin-svelte": "^3.5.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "semver": "^7.8.5",
    "storybook": "10.5.7",
    "svelte-check": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vite": "7.3.2",
    "vitest": "4.1.11",
    "webdriverio": "9.31.2"
  }
}
