{
  "name": "@lapismd/lapis-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24.10 || >=26"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "node scripts/validation.mjs run build",
    "check": "node scripts/validation.mjs run check",
    "check:types": "node scripts/validation.mjs run check:types",
    "check:rust": "node scripts/validation.mjs run check:rust",
    "check:architecture": "node scripts/validation.mjs run check:architecture",
    "check:app-ownership": "node scripts/validation.mjs run check:app-ownership",
    "format:check": "node scripts/validation.mjs run format:check",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test": "node scripts/validation.mjs run test",
    "test:desktop": "node scripts/validation.mjs run test:desktop",
    "desktop:bundle": "tauri build --bundles app",
    "build:local:macos": "node scripts/local-macos-build.mjs",
    "spec:validate": "node scripts/validation.mjs run spec:validate",
    "spec:first": "node scripts/validation.mjs run spec:first",
    "spec:check": "node scripts/validation.mjs run spec:check",
    "spec:build": "node scripts/validation.mjs run spec:build",
    "spec:serve": "spec-validator serve",
    "spec:search": "spec-validator search --semantic",
    "check:bundle": "node scripts/check-bundle.mjs",
    "local:install": "node scripts/local-archives.mjs",
    "local:pack": "node scripts/pack-local-core.mjs",
    "local:refresh": "node scripts/refresh-local-dependencies.mjs",
    "local:status": "node scripts/refresh-local-dependencies.mjs --check",
    "storybook": "storybook dev --host 127.0.0.1 --port 7480 --no-open --disable-telemetry",
    "storybook:start": "node scripts/storybook.mjs start",
    "storybook:status": "node scripts/storybook.mjs status",
    "storybook:stop": "node scripts/storybook.mjs stop",
    "storybook:restart": "node scripts/storybook.mjs restart",
    "storybook:clean": "node scripts/storybook.mjs clean",
    "build-storybook": "node scripts/validation.mjs run build-storybook",
    "test:storybook": "node scripts/validation.mjs run test:storybook",
    "test:ai": "node scripts/validation.mjs run test:ai",
    "test:desktop:headless": "node scripts/validation.mjs run test:desktop:headless",
    "test:desktop:headed": "node scripts/desktop-tests.mjs --headed",
    "test:desktop:api": "node scripts/desktop-api-tests.mjs",
    "test:desktop:onnx": "node scripts/desktop-api-tests.mjs --onnx",
    "test:provider:live": "node scripts/live-provider-tests.mjs",
    "test:native:macos": "node scripts/macos-native-lanes.mjs",
    "ai:prepare": "node scripts/prepare-ai.mjs",
    "check:all": "node scripts/validation.mjs run check:all",
    "test:rust": "node scripts/validation.mjs run test:rust",
    "validation:check": "node scripts/validation.mjs run validation:check",
    "validation:smoke": "node scripts/validation.mjs run validation:smoke",
    "check:storybook-parity": "node scripts/validation.mjs run check:storybook-parity",
    "validation": "node scripts/validation.mjs",
    "validation:doctor": "node scripts/validation.mjs doctor",
    "validation:images": "node scripts/validation.mjs images",
    "check:rust:e2e": "node scripts/validation.mjs run check:rust:e2e",
    "check:evidence": "node scripts/validation.mjs run check:evidence",
    "spec:index": "spec-validator index",
    "ci:governance": "pnpm spec:check && pnpm spec:first --base \"${LAPIS_DESKTOP_BASE:?}\" --head \"${LAPIS_DESKTOP_HEAD:?}\"",
    "ci:quality": "pnpm check",
    "ci:unit": "pnpm test",
    "ci:storybook-static": "pnpm build-storybook",
    "ci:storybook-interaction": "pnpm test:storybook",
    "ci:bundle": "pnpm build && pnpm desktop:bundle --debug && pnpm check:bundle",
    "ci:headed": "pnpm test:desktop:headed",
    "checks": "node scripts/run-turbo.mjs ci:governance ci:storybook-static --summarize && node scripts/run-turbo.mjs ci:storybook-interaction --summarize && node scripts/run-turbo.mjs ci:quality --summarize && node scripts/run-turbo.mjs ci:unit --summarize && node scripts/run-turbo.mjs ci:bundle --summarize"
  },
