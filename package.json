    "@lapismd/agent-ui": "^0.1.0",
    "@lapismd/repository-ui": "^0.1.0",
    "@lapis-notes/app-profile": "^0.0.0"
  },
  "devDependencies": {
    "@lapismd/spec-validator": "^0.2.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/svelte-vite": "10.6.5",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tauri-apps/cli": "2.12.3",
