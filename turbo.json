{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": true,
    "timeout": 10,
    "uploadTimeout": 30
  },
  "futureFlags": {
    "longerSignatureKey": true
  },
  "globalEnv": [
    "CI",
    "LAPIS_DESKTOP_BASE",
    "LAPIS_DESKTOP_HEAD",
    "LAPIS_DESKTOP_VALIDATION_RUNTIME",
    "LAPIS_DESKTOP_PORTABLE_FIXTURES",
    "VECTORSCAN_PREBUILT_DIR",
    "VECTORSCAN_OFFLINE"
  ],
  "tasks": {
    "ci:governance": {
      "cache": false,
      "outputs": []
    },
    "ci:quality": {
      "cache": false,
      "outputs": [],
      "env": ["LAPIS_CI_QUALITY_GROUPS", "LAPIS_CI_RUST_PACKAGES"]
    },
    "ci:unit": {
      "cache": false,
      "outputs": [],
      "env": ["LAPIS_CI_UNIT_GROUPS", "LAPIS_CI_RUST_PACKAGES"]
    },
    "ci:storybook-static": {
      "outputs": ["storybook-static/**"]
    },
    "ci:storybook-interaction": {
      "env": ["LAPIS_DESKTOP_CATALOG_SHARD", "LAPIS_DESKTOP_CATALOG_PROFILE"],
      "outputs": [".local/catalog-reports/**"]
    },
    "ci:bundle": {
      "cache": false,
      "outputs": []
    },
    "ci:headed": {
      "cache": false,
      "outputs": []
    }
  }
}
